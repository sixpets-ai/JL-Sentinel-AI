function speakTextNative(text: string, agent: Agent, onEnd: () => void): void {
  if (!window.speechSynthesis) { onEnd(); return; }
  window.speechSynthesis.cancel();
  const isFemale = agent.gender === "female";
  const u = new SpeechSynthesisUtterance(text);
  u.lang = "es-US";
  u.volume = 1;
  if (isFemale) {
    u.pitch = 1.8;
    u.rate = 1.0;
  } else {
    u.pitch = 0.2;
    u.rate = 0.75;
  }
  const voices = window.speechSynthesis.getVoices();
  const esVoices = voices.filter(v => v.lang.toLowerCase().startsWith("es"));
  if (esVoices.length > 0) {
    if (isFemale) {
      const fem = esVoices.find(v => /female|mujer|sofia|paulina|helena|sabina|laura|monica|mónica|lucia/i.test(v.name));
      u.voice = fem || esVoices[0];
    } else {
      const masc = esVoices.find(v => /male|hombre|jorge|diego|juan|carlos|enrique|raul|pablo|miguel/i.test(v.name));
      u.voice = masc || esVoices[0];
    }
  }
  u.onend = onEnd;
  u.onerror = onEnd;
  setTimeout(() => { try { window.speechSynthesis.speak(u); } catch(e) { onEnd(); } }, 100);
}

async function speakTextWatson(text: string, agent: Agent, onEnd: () => void): Promise<void> {
  try {
    const res = await fetch("/api/tts", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ text: text.substring(0, 800), agent: agent.id }) });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const blob = await res.blob(); const url = URL.createObjectURL(blob); const audio = new Audio(url);
    audio.onended = () => { URL.revokeObjectURL(url); onEnd(); };
    audio.onerror = () => { URL.revokeObjectURL(url); speakTextNative(text, agent, onEnd); };
    await audio.play(); (window as any).currentAudio = audio;
  } catch { speakTextNative(text, agent, onEnd); }
}

export const AgenteAvatar: React.FC = () => {
  const [authed, setAuthed] = useState(() => localStorage.getItem("santi_auth") === "true");
  const [activeAgent, setActiveAgent] = useState<Agent>(AGENT_SANTI);
  const [messages, setMessages] = useState<Msg[]>([{ role: "agent", text: "SISTEMA SANTI NEXUS EN LÍNEA.", agent: AGENT_SANTI.id, timestamp: new Date().toLocaleTimeString(), id: "1", priority: "normal" }]);
  const [input, setInput] = useState("");
  const [thinking, setThinking] = useState(false);
  const [speaking, setSpeaking] = useState(false);
  const chatEndRef = useRef<HTMLDivElement>(null);

  useEffect(() => { chatEndRef.current?.scrollIntoView({ behavior: "smooth" }); }, [messages]);

  const selectAgent = (ag: Agent) => {
    if ((window as any).currentAudio) (window as any).currentAudio.pause();
    if (window.speechSynthesis) window.speechSynthesis.cancel();
    setSpeaking(false); setActiveAgent(ag);
    setMessages([{ role: "agent", text: `${ag.name} EN LÍNEA.`, agent: ag.id, timestamp: new Date().toLocaleTimeString(), id: Date.now().toString(), priority: "normal" }]);
    setSpeaking(true); speakTextWatson(`${ag.name} en línea.`, ag, () => setSpeaking(false));
  };

  const sendMessage = async () => {
    if (!input.trim() || thinking) return;
    const msg = input.trim(); setInput("");
    setMessages(m => [...m, { role: "user", text: msg, timestamp: new Date().toLocaleTimeString(), id: Date.now().toString(), priority: "normal" }]);
    setThinking(true);
    try {
      const res = await fetch("/api/chat", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ agent: activeAgent.id, prompt: msg }) });
      const data = await res.json(); const reply = data.response || "Sin respuesta.";
      setMessages(m => [...m, { role: "agent", text: reply, agent: activeAgent.id, timestamp: new Date().toLocaleTimeString(), id: Date.now().toString(), priority: "normal" }]);
      setSpeaking(true); speakTextWatson(reply, activeAgent, () => setSpeaking(false));
    } catch { setMessages(m => [...m, { role: "agent", text: "ERROR.", agent: activeAgent.id, timestamp: new Date().toLocaleTimeString(), id: Date.now().toString(), priority: "critical" }]); }
    setThinking(false);
  };

  if (!authed) return (
    <div style={{ height: "100vh", display: "flex", flexDirection: "column", justifyContent: "center", alignItems: "center", background: "#020810", color: "#00ffcc", fontFamily: "monospace" }}>
      <h1>SANTI NEXUS</h1>
      <div onClick={() => { setAuthed(true); localStorage.setItem("santi_auth", "true"); }} style={{ width: 100, height: 100, borderRadius: "50%", border: "2px solid #00ffcc", display: "flex", justifyContent: "center", alignItems: "center", cursor: "pointer", margin: 20, fontSize: 40 }}>🔒</div>
    </div>
  );

  return (
    <div style={{ display: "flex", height: "100vh", background: "#020810", color: "#e0ffe8", fontFamily: "monospace", overflow: "hidden" }}>
      <div style={{ width: 160, borderRight: "1px solid rgba(0,255,200,0.1)", padding: 10, display: "flex", flexDirection: "column", gap: 8, background: "rgba(2,8,16,0.9)" }}>
        <p style={{ color: "#00ffcc", fontSize: 9, textAlign: "center" }}>AGENTES</p>
        {ALL_AGENTS.map((a) => (
          <button key={a.id} onClick={() => selectAgent(a)} style={{ background: activeAgent.id === a.id ? `${a.color}22` : "transparent", border: `1px solid ${activeAgent.id === a.id ? a.color : "transparent"}`, borderRadius: 8, padding: 8, cursor: "pointer", display: "flex", flexDirection: "column", alignItems: "center", gap: 4 }}>
            <div style={{ width: 40, height: 40, borderRadius: "50%", background: `${a.color}33`, border: `2px solid ${a.color}`, display: "flex", justifyContent: "center", alignItems: "center", fontSize: 20 }}>{a.icon}</div>
            <span style={{ color: a.color, fontSize: 8, fontWeight: "bold" }}>{a.name}</span>
          </button>
        ))}
      </div>
      <div style={{ flex: 1, display: "flex", flexDirection: "column", borderRight: "1px solid rgba(0,255,200,0.1)" }}>
        <div style={{ padding: 15, borderBottom: "1px solid rgba(0,255,200,0.1)", display: "flex", alignItems: "center", gap: 20, background: `linear-gradient(90deg, ${activeAgent.color}22 0%, transparent 100%)` }}>
          <div style={{ width: 150, height: 250 }}><HologramAvatar agent={activeAgent} speaking={speaking} /></div>
          <div style={{ flex: 1 }}>
            <h2 style={{ margin: 0, fontSize: 20, color: activeAgent.color }}>{activeAgent.name}</h2>
            <p style={{ margin: "5px 0", fontSize: 12, color: "#8aa" }}>DIVISIÓN: {activeAgent.division}</p>
            <p style={{ margin: 0, fontSize: 12, color: "#8aa" }}>NIVEL: {activeAgent.clearance}</p>
          </div>
          <button onClick={() => { if ((window as any).currentAudio) (window as any).currentAudio.pause(); if (window.speechSynthesis) window.speechSynthesis.cancel(); setSpeaking(false); }} style={{ padding: "10px 20px", background: "#ff1744", border: "none", color: "#fff", borderRadius: 6, cursor: "pointer", fontWeight: "bold" }}>🛑 SILENCIO</button>
        </div>
        <div style={{ flex: 1, overflowY: "auto", padding: 20 }}>
          {messages.map(m => (
            <div key={m.id} style={{ marginBottom: 15, display: "flex", justifyContent: m.role === "user" ? "flex-end" : "flex-start" }}>
              <div style={{ padding: "10px 15px", borderRadius: 8, background: m.role === "user" ? "rgba(200,168,75,0.15)" : `${activeAgent.color}15`, border: `1px solid ${m.role === "user" ? "#c8a84b" : activeAgent.color}`, fontSize: 12, maxWidth: "80%", lineHeight: 1.6 }}>{m.text}</div>
            </div>
          ))}
          {thinking && <p style={{ color: "#00ffcc", fontSize: 10 }}>⏳ Procesando...</p>}
          <div ref={chatEndRef} />
        </div>
        <div style={{ padding: 15, borderTop: "1px solid rgba(0,255,200,0.1)", display: "flex", gap: 10 }}>
          <input value={input} onChange={e => setInput(e.target.value)} onKeyDown={e => e.key === "Enter" && sendMessage()} placeholder="Consulta táctica..." style={{ flex: 1, padding: 12, background: "rgba(0,20,12,0.8)", border: "1px solid #00ffcc", borderRadius: 6, color: "#fff", fontSize: 12 }} />
          <button onClick={sendMessage} style={{ padding: "12px 25px", background: "rgba(0,255,200,0.15)", border: "1px solid #00ffcc", color: "#00ffcc", borderRadius: 6, fontSize: 12, fontWeight: "bold" }}>ENVIAR</button>
        </div>
      </div>
    </div>
  );
};


