import React, { useState, useEffect, useRef, useCallback } from "react";
import {
  MapContainer, TileLayer, Marker, Popup, Circle, Polyline,
  Tooltip, useMap, useMapEvents, CircleMarker
} from "react-leaflet";
import * as L from "leaflet";
import MarkerClusterGroup from "react-leaflet-cluster";
import "react-leaflet-cluster/dist/assets/MarkerCluster.css";
import "react-leaflet-cluster/dist/assets/MarkerCluster.Default.css";

// ============================================================================
// 1. TIPOS E INTERFACES (INTACTOS)
// ============================================================================
export interface PanicAlert {
  officerId: string; lat: number; lng: number; message: string;
  timestamp: string; status: "ACTIVE" | "RESOLVED"; folio: string;
  sha256: string; closestUnits: Array<{ id: string; corp: string; distanceM: number }>;
}

export interface PatrolUnit {
  pos: [number, number]; id: string; corp: string; folio: string | null;
  status: string; color: string; azimuth: number; speed: number;
  event: { type: string; date: string; time: string; freq: number; route: string };
}

export interface InfraNode {
  pos: [number, number]; type: "hospital" | "school" | "gov"; name: string;
}

const CMO_CENTER: [number, number] = [18.9242, -99.2216];
const CMO_ZOOM = 12;

// ============================================================================
// 2. MATEMÁTICAS Y TOPOGRAFÍA (INTACTAS)
// ============================================================================
function offsetLL(lat: number, lng: number, bearingDeg: number, distM: number): [number, number] {
  const R = 6371000, d = distM / R, br = (bearingDeg * Math.PI) / 180;
  const p1 = (lat * Math.PI) / 180, l1 = (lng * Math.PI) / 180;
  const p2 = Math.asin(Math.sin(p1) * Math.cos(d) + Math.cos(p1) * Math.sin(d) * Math.cos(br));
  const l2 = l1 + Math.atan2(Math.sin(br) * Math.sin(d) * Math.cos(p1), Math.cos(d) - Math.sin(p1) * Math.sin(p2));
  return [(p2 * 180) / Math.PI, (l2 * 180) / Math.PI];
}

function azimuthSector(lat: number, lng: number, bearingDeg: number, halfWidth: number, innerM: number, outerM: number, steps = 16): [number, number][] {
  const startA = bearingDeg - halfWidth, endA = bearingDeg + halfWidth, pts: [number, number][] = [];
  for (let i = 0; i <= steps; i++) pts.push(offsetLL(lat, lng, startA + ((endA - startA) * i) / steps, outerM));
  for (let i = steps; i >= 0; i--) pts.push(offsetLL(lat, lng, startA + ((endA - startA) * i) / steps, innerM));
  pts.push(pts[0]); return pts;
}

function calculateBearing(lat1: number, lon1: number, lat2: number, lon2: number): number {
  const toR = (deg: number) => (deg * Math.PI) / 180, toD = (rad: number) => (rad * 180) / Math.PI;
  const p1 = toR(lat1), p2 = toR(lat2), dl = toR(lon2 - lon1);
  const y = Math.sin(dl) * Math.cos(p2), x = Math.cos(p1) * Math.sin(p2) - Math.sin(p1) * Math.cos(p2) * Math.cos(dl);
  return (toD(Math.atan2(y, x)) + 360) % 360;
}

// ============================================================================
// 3. ESTILOS CSS TÁCTICOS (HUD MILITAR, RADAR Y VISIÓN NOCTURNA)
// ============================================================================
if (typeof document !== "undefined") {
  const s = document.createElement("style");
  s.textContent = `
    /* FILTRO SATELITAL TÁCTICO (ESTILO COD/GTA) */
    .leaflet-tile-pane { 
      filter: grayscale(100%) brightness(0.35) contrast(1.8) sepia(0.4) hue-rotate(140deg) saturate(2.5) !important; 
    }
    
    /* CUADRÍCULA TÁCTICA MILITAR SOBRE EL MAPA */
    .tactical-grid {
      position: absolute; inset: 0; z-index: 400; pointer-events: none;
      background-image: 
        linear-gradient(to right, rgba(0, 255, 200, 0.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(0, 255, 200, 0.05) 1px, transparent 1px);
      background-size: 60px 60px;
    }

    /* ANIMACIÓN DE RADAR DE BARRIDO CONTINUO */
    @keyframes radar-sweep {
      0% { transform: translate(-50%, -50%) rotate(0deg); }
      100% { transform: translate(-50%, -50%) rotate(360deg); }
    }
    .radar-sweep-overlay {
      position: absolute; top: 50%; left: 50%; width: 200vw; height: 200vw;
      z-index: 401; pointer-events: none;
      background: conic-gradient(from 0deg, transparent 60%, rgba(0, 255, 200, 0.15) 100%);
      animation: radar-sweep 6s linear infinite;
      border-radius: 50%;
    }

    /* ANIMACIONES DE SIRENAS */
    @keyframes siren-flash { 0%, 49% { opacity: 1; filter: drop-shadow(0 0 10px #ff0000); } 50%, 100% { opacity: 0.2; filter: drop-shadow(0 0 2px #ff0000); } }
    @keyframes siren-blue { 0%, 49% { opacity: 0.2; } 50%, 100% { opacity: 1; filter: drop-shadow(0 0 10px #00e5ff); } }
    .siren-r { animation: siren-flash 0.4s infinite; }
    .siren-b { animation: siren-blue 0.4s infinite; }

    /* PANELES Y BOTONES TÁCTICOS */
    .tac-panel { background: rgba(2, 8, 16, 0.95); border: 1px solid rgba(0, 255, 200, 0.3); box-shadow: 0 0 20px rgba(0,0,0,0.8); border-radius: 8px; padding: 15px; backdrop-filter: blur(5px); }
    .tac-btn { display: block; width: 100%; text-align: left; background: rgba(0, 20, 16, 0.9); border: 1px solid rgba(0, 255, 200, 0.4); color: #00ffcc; padding: 10px 12px; font-family: monospace; font-size: 11px; cursor: pointer; border-radius: 4px; margin-bottom: 8px; text-transform: uppercase; transition: all 0.2s; }
    .tac-btn:hover { background: rgba(0, 255, 200, 0.15); border-color: #00ffcc; box-shadow: 0 0 10px rgba(0,255,200,0.3); }
    .tac-btn.danger { border-color: rgba(255, 23, 68, 0.6); color: #ff1744; }
    .tac-btn.danger:hover { background: rgba(255, 23, 68, 0.15); border-color: #ff1744; box-shadow: 0 0 10px rgba(255,23,68,0.3); }

    /* CLUSTERS DE NODOS */
    .marker-cluster-small, .marker-cluster-medium, .marker-cluster-large { background-color: rgba(0,255,136,0.1)!important; border:1.5px solid rgba(0,255,136,0.5)!important; }
    .marker-cluster-small div, .marker-cluster-medium div, .marker-cluster-large div { background-color: rgba(0,0,10,0.9)!important; color: #00ff88!important; font-family: monospace!important; font-weight: 700!important; }
  `;
  document.head.appendChild(s);
}

// ============================================================================
// 4. ICONOS (INTACTOS)
// ============================================================================
function buildVehicleIcon(corp: string, color: string, azimuth: number): L.DivIcon {
  let svgBody = `<path d="M12,5 L28,5 L31,12 L33,30 L7,30 L9,12 Z" fill="#050810" stroke="${color}" stroke-width="1.5"/>`; 
  let lights = `<rect class="siren-r" x="14" y="6" width="4" height="3" fill="#ff1744"/><rect class="siren-b" x="22" y="6" width="4" height="3" fill="#00e5ff"/>`;
  if (corp === "CRUZ_ROJA") { svgBody = `<rect x="10" y="8" width="20" height="24" rx="3" fill="#e0e0e0" stroke="${color}" stroke-width="1.5"/><path d="M18,12 L22,12 L22,16 L26,16 L26,20 L22,20 L22,24 L18,24 L18,20 L14,20 L14,16 L18,16 Z" fill="#ff1744"/>`; lights = `<rect class="siren-r" x="14" y="6" width="12" height="4" fill="#ff1744"/>`; }
  else if (corp === "SEFO") { svgBody = `<rect x="8" y="5" width="24" height="30" rx="2" fill="#b71c1c" stroke="${color}" stroke-width="1.5"/><rect x="12" y="15" width="16" height="10" fill="#111"/>`; lights = `<rect class="siren-r" x="12" y="6" width="16" height="3" fill="#ffff00"/>`; }
  else if (corp === "PERITO") { svgBody = `<rect x="12" y="10" width="16" height="20" rx="2" fill="#333" stroke="${color}" stroke-width="1.5"/><circle cx="20" cy="20" r="4" fill="#00e5ff"/>`; lights = `<rect x="18" y="5" width="4" height="4" fill="#ffff00" class="siren-r"/>`; }
  else if (corp === "GN" || corp === "EST") { svgBody = `<rect x="10" y="8" width="20" height="24" rx="2" fill="#050810" stroke="${color}" stroke-width="1.5"/><rect x="14" y="12" width="12" height="15" fill="rgba(180,225,255,0.1)"/>`; }
  return L.divIcon({ className: "", iconSize: [40, 40], iconAnchor: [20, 20], html: `<div style="transform: rotate(${azimuth}deg); filter: drop-shadow(0 0 8px ${color});"><svg width="40" height="40" viewBox="0 0 40 40">${svgBody}${lights}</svg></div>` });
}

const hqIcon = L.divIcon({ className: "", iconSize: [44, 44], iconAnchor: [22, 22], html: `<div style="width:44px;height:44px;border-radius:50%;background:rgba(0,255,200,0.1);border:2px solid #00ffcc;display:flex;align-items:center;justify-content:center;font-size:22px;">🏛️</div>` });
const panicIcon = L.divIcon({ className: "", iconSize: [48, 48], iconAnchor: [24, 24], html: `<div style="width:48px;height:48px;border-radius:50%;background:rgba(255,23,68,0.2);border:3px solid #ff1744;display:flex;align-items:center;justify-content:center;font-size:26px;animation:siren-flash 0.5s infinite;">🆘</div>` });

const infraIcons: Record<string, L.DivIcon> = {
  hospital: L.divIcon({ className: "", iconSize: [26, 26], iconAnchor: [13, 13], html: `<div style="width:26px;height:26px;background:rgba(255,255,255,0.85);border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:16px;">🏥</div>` }),
  school: L.divIcon({ className: "", iconSize: [26, 26], iconAnchor: [13, 13], html: `<div style="width:26px;height:26px;background:rgba(255,255,255,0.85);border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:16px;">🏫</div>` }),
  gov: L.divIcon({ className: "", iconSize: [26, 26], iconAnchor: [13, 13], html: `<div style="width:26px;height:26px;background:rgba(255,255,255,0.85);border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:16px;">🏛️</div>` })
};

function createClusterCustomIcon(cluster: any): L.DivIcon {
  const count = cluster.getChildCount(), size = count > 1000 ? 48 : count > 100 ? 40 : 32, color = count > 1000 ? "#ff6d00" : count > 100 ? "#c8a84b" : "#00ff88";
  return L.divIcon({ html: `<div style="width:${size}px;height:${size}px;border-radius:50%;background:rgba(0,0,10,0.9);border:2px solid ${color};display:flex;align-items:center;justify-content:center;color:${color};font-weight:bold;font-family:monospace;">${count > 999 ? "1k+" : count}</div>`, className: "", iconSize: [size, size], iconAnchor: [size / 2, size / 2] });
}

// ============================================================================
// 5. DATOS (INTACTOS - ESCALABILIDAD MUNDIAL)
// ============================================================================
const CORPS = ["MUN", "GN", "SSPC", "EST", "CRUZ_ROJA", "SEFO"];
const CORP_COLORS: Record<string, string> = { MUN: "#1e88e5", GN: "#00e676", SSPC: "#c8a84b", EST: "#9c27b0", CRUZ_ROJA: "#ff1744", SEFO: "#b71c1c" };
const PATROL_UNITS_BASE: PatrolUnit[] = [
  { pos: [18.9310, -99.2300], id: "P-042", corp: "SSPC", folio: "SSPC-26-0042", status: "Patrullando", color: "#c8a84b", azimuth: 35, speed: 60, event: { type: "Patrullaje preventivo", date: "2026-11-07", time: "07:30", freq: 1, route: "Av. Morelos" } },
  { pos: [18.9180, -99.2100], id: "AMB-01", corp: "CRUZ_ROJA", folio: "CR-26-011", status: "Atendiendo Emergencia", color: "#ff1744", azimuth: 120, speed: 90, event: { type: "Traslado herido", date: "2026-11-07", time: "08:12", freq: 1, route: "Hospital General" } },
  { pos: [18.9400, -99.2050], id: "B-107", corp: "SEFO", folio: "SEFO-26-0107", status: "Incendio Activo", color: "#b71c1c", azimuth: 270, speed: 80, event: { type: "Sofocando fuego", date: "2026-11-07", time: "09:00", freq: 1, route: "Bodega Central" } },
  { pos: [18.9150, -99.2350], id: "PER-4", corp: "PERITO", folio: "FGR-26-0318", status: "Levantando Evidencia", color: "#1e88e5", azimuth: 200, speed: 0, event: { type: "Procesamiento de escena", date: "2026-11-07", time: "08:45", freq: 1, route: "Centro histórico" } },
  { pos: [18.9280, -99.1980], id: "P-401", corp: "SEMAR", folio: "IPH-26-0401", status: "Alerta activa", color: "#ff1744", azimuth: 345, speed: 80, event: { type: "CÓDIGO ROJO", date: "2026-11-07", time: "09:22", freq: 1, route: "Blvd. Zapata" } },
];
const INFRA_NODES: InfraNode[] = [
  { pos: [18.9210, -99.2250], type: "hospital", name: "Hospital General" },
  { pos: [18.9350, -99.2150], type: "school", name: "Escuela Primaria" },
  { pos: [18.9250, -99.2350], type: "gov", name: "Palacio Municipal" },
];
// ESCALABILIDAD: 10,000 unidades distribuidas geográficamente (Simulación de cobertura nacional)
const NATIONAL_PATROL_UNITS = Array.from({ length: 10000 }).map((_, i) => ({ 
  pos: [14.5 + Math.random() * 18, -117.1 + Math.random() * 30] as [number, number], 
  color: CORP_COLORS[CORPS[Math.floor(Math.random() * CORPS.length)]], 
  id: `N-${i}` 
}));

// ============================================================================
// 6. HOOKS Y FÍSICA (INTACTOS)
// ============================================================================
function PanicFlyTo({ alerts }: { alerts: PanicAlert[] }) {
  const map = useMap(), lastRef = useRef<string | null>(null);
  useEffect(() => { if (alerts.length && alerts[0].folio !== lastRef.current) { lastRef.current = alerts[0].folio; map.flyTo([alerts[0].lat, alerts[0].lng], 15); } }, [alerts, map]);
  return null;
}
function MapClickNoop() { useMapEvents({ click: (e) => { (e.originalEvent as Event).stopPropagation(); } }); return null; }
function usePatrolPhysics(units: PatrolUnit[]) {
  const [positions, setPositions] = useState(units.map((u) => ({ pos: u.pos, azimuth: u.azimuth })));
  const wpRef = useRef(units.map((u) => Array.from({ length: 4 }, (_, i) => [u.pos[0] + Math.sin((i * Math.PI) / 2) * 0.015, u.pos[1] + Math.cos((i * Math.PI) / 2) * 0.015] as [number, number])));
  const stateRef = useRef(units.map(() => ({ targetIdx: 1, progress: 0 })));
  useEffect(() => {
    let frameId: number, lastTime = performance.now();
    const animate = (time: number) => {
      const dt = time - lastTime; lastTime = time;
      if (dt > 50) setPositions((prev) => prev.map((item, i) => {
          if (units[i].speed === 0) return item;
          const state = stateRef.current[i], targetWp = wpRef.current[i][state.targetIdx];
          state.progress += dt * 0.0000003 * units[i].speed;
          if (state.progress >= 1) { state.progress = 0; state.targetIdx = (state.targetIdx + 1) % 4; }
          const curWp = wpRef.current[i][(state.targetIdx - 1 + 4) % 4];
          const newLat = curWp[0] + (targetWp[0] - curWp[0]) * state.progress, newLng = curWp[1] + (targetWp[1] - curWp[1]) * state.progress;
          return { pos: [newLat, newLng] as [number, number], azimuth: calculateBearing(newLat, newLng, targetWp[0], targetWp[1]) };
        }));
      frameId = requestAnimationFrame(animate);
    };
    frameId = requestAnimationFrame(animate); return () => cancelAnimationFrame(frameId);
  }, [units]);
  return positions;
}

// ============================================================================
// 7. COMPONENTES UI (INTACTOS)
// ============================================================================
function HardDataPopup({ title, color, rows }: { title: string; color: string; rows: Array<{ label: string; value: React.ReactNode }> }) {
  return (
    <div style={{ fontFamily: "monospace", fontSize: 11, background: "#020810", color: "#e0ffe8", padding: 12, borderRadius: 6, border: `1px solid ${color}`, minWidth: 240 }}>
      <p style={{ color, fontWeight: "bold", margin: "0 0 10px 0", borderBottom: `1px solid ${color}50`, paddingBottom: 5 }}>{title}</p>
      {rows.map(({ label, value }) => (
        <div key={label} style={{ display: "flex", justifyContent: "space-between", gap: 10, marginBottom: 4 }}><span style={{ color: "#4a8a6a" }}>{label}</span><span style={{ textAlign: "right", fontWeight: "bold" }}>{value}</span></div>
      ))}
    </div>
  );
}
function TriangulationLayer({ point, onClear }: { point: [number, number] | null; onClear: () => void }) {
  if (!point) return null;
  const radii = [500, 1200, 2500], colors = ["#ff1744", "#ff6d00", "#c8a84b"];
  return (
    <>
      {radii.map((r, i) => <Circle key={r} center={point} radius={r} pathOptions={{ color: colors[i], weight: i === 0 ? 2.5 : 1.5, opacity: 0.8, fillColor: colors[i], fillOpacity: 0.05, dashArray: i > 0 ? "6 8" : undefined }} />)}
      <Marker position={point} icon={L.divIcon({ className: "", iconSize: [30, 30], iconAnchor: [15, 15], html: `<div style="width:30px;height:30px;position:relative;"><div style="position:absolute;top:0;bottom:0;left:14px;width:2px;background:#ff1744;"></div><div style="position:absolute;left:0;right:0;top:14px;height:2px;background:#ff1744;"></div><div style="position:absolute;inset:10px;border-radius:50%;border:2px solid #ff1744;"></div></div>` })} />
    </>
  );
}
const PanicAlertsLayer = ({ alerts }: { alerts: PanicAlert[] }) => (
  <>
    {alerts.map((a, idx) => (
      <React.Fragment key={`panic-${idx}`}>
        <Marker position={[a.lat, a.lng]} icon={panicIcon}><Popup><HardDataPopup title="🆘 CÓDIGO ROJO" color="#ff1744" rows={[{ label: "Oficial", value: a.officerId }, { label: "Folio", value: a.folio }]} /></Popup></Marker>
        <Circle center={[a.lat, a.lng]} radius={500} pathOptions={{ color: "#ff1744", weight: 2, opacity: 0.8, fillOpacity: 0.2 }} />
      </React.Fragment>
    ))}
  </>
);

// ============================================================================
// 8. COMPONENTE PRINCIPAL (BLINDADO + VISIÓN TÁCTICA)
// ============================================================================
export const TacticalMap = () => {
  const [panicAlerts, setPanicAlerts] = useState<PanicAlert[]>([]);
  const [triActive, setTriActive] = useState(false);
  const [triPoint, setTriPoint] = useState<[number, number] | null>(null);
  
  const patrolData = usePatrolPhysics(PATROL_UNITS_BASE);
  const handleTriPoint = useCallback((pos: [number, number]) => { setTriPoint(pos); setTriActive(false); }, []);

  useEffect(() => {
    const poll = async () => { try { const res = await fetch("/api/panic-state"); if (res.ok) setPanicAlerts((await res.json()).alerts ?? []); } catch {} };
    const id = setInterval(poll, 3000); return () => clearInterval(id);
  }, []);

  return (
    <div style={{ height: "100vh", width: "100%", position: "relative", backgroundColor: "#020810", fontFamily: "monospace", overflow: "hidden" }}>
      
      {/* OVERLAYS DEL HUD MILITAR (Fijos en pantalla) */}
      <div className="tactical-grid" />
      <div className="radar-sweep-overlay" />

      {/* PANEL TÁCTICO */}
      <div className="tac-panel" style={{ position: "absolute", top: 80, left: 20, zIndex: 1000, width: "240px" }}>
        <h3 style={{ color: "#00ffcc", fontSize: "12px", marginBottom: "15px", borderBottom: "1px solid #00ffcc40" }}>COMANDO TÁCTICO</h3>
        <button className="tac-btn danger" onClick={() => alert("Ejecutando Asalto a Bodega...")}>💥 Asalto a Bodega</button>
        <button className="tac-btn danger" onClick={() => alert("Desmantelando Laboratorio...")}>🧪 Desmantelar Lab</button>
        <button className="tac-btn" onClick={() => alert("Desplegando Peritos...")}>🔬 Desplegar Peritos</button>
        <button className="tac-btn" onClick={() => alert("Solicitando Cruz Roja...")}>🚑 Solicitar Cruz Roja</button>
        <button className="tac-btn" onClick={() => { setTriActive(true); alert("Haz clic en el mapa para triangular"); }}>🎯 Triangular Objetivo</button>
      </div>

      <MapContainer center={CMO_CENTER} zoom={CMO_ZOOM} style={{ height: "100%", width: "100%", background: "#000" }} zoomControl={false} preferCanvas={true}>
        
        {/* 🔥 MAPA BASE: Satélite Real Táctico (Worldwide, sin API Key) */}
        <TileLayer 
          url="https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}" 
          attribution="" 
          maxZoom={19}
        />
        
        <MapClickNoop />

        {/* HQ e Infraestructura */}
        <Marker position={CMO_CENTER} icon={hqIcon}>
          <Popup><HardDataPopup title="C.M.O. NACIONAL" color="#00ffcc" rows={[{ label: "Estatus", value: "Operativo" }]} /></Popup>
        </Marker>

        {INFRA_NODES.map((node, i) => (
          <Marker key={`infra-${i}`} position={node.pos} icon={infraIcons[node.type]}>
            <Tooltip direction="top"><span style={{ fontFamily: "monospace", fontSize: 10, fontWeight: "bold" }}>{node.name}</span></Tooltip>
          </Marker>
        ))}

        {/* Patrullas Locales con Física y Radares */}
        {PATROL_UNITS_BASE.map((u, i) => {
          const data = patrolData[i];
          return (
            <React.Fragment key={u.id}>
              <Polyline positions={azimuthSector(data.pos[0], data.pos[1], data.azimuth, 25, 50, 300)} pathOptions={{ color: u.color, weight: 1, fillColor: u.color, fillOpacity: 0.1 }} />
              <Marker position={data.pos} icon={buildVehicleIcon(u.corp, u.color, data.azimuth)}>
                <Popup><HardDataPopup title={`UNIDAD ${u.id}`} color={u.color} rows={[{ label: "Estatus", value: u.status }, { label: "Acción", value: u.event.type }, { label: "Corporación", value: u.corp }]} /></Popup>
              </Marker>
            </React.Fragment>
          );
        })}

        {/* 🔥 CLUSTERING DE 10,000 UNIDADES (Optimizado con Canvas para no crashear) */}
        {/* @ts-ignore */}
        <MarkerClusterGroup chunkedLoading iconCreateFunction={createClusterCustomIcon}>
          {NATIONAL_PATROL_UNITS.map((u, i) => (
            <CircleMarker 
              key={`n-${i}`} 
              center={u.pos} 
              radius={3} 
              pathOptions={{ color: u.color, fillColor: u.color, fillOpacity: 0.8, weight: 1 }} 
            />
          ))}
        </MarkerClusterGroup>

        {/* Alertas Críticas de Pánico (Código Rojo) */}
        <PanicFlyTo alerts={panicAlerts} />
        <PanicAlertsLayer alerts={panicAlerts} />
        
        {/* Herramienta de Triangulación */}
        <TriangulationLayer point={triPoint} onClear={() => setTriPoint(null)} />
      </MapContainer>
    </div>
  );
};