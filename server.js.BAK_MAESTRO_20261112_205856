async function chatAgent(agentId, prompt) {
  const agent = AGENTS[agentId] || AGENTS.SANTI;
  const cacheKey = `${agentId}:${prompt.substring(0,100)}`;
  const cached = cacheGet(cacheKey); if (cached) return { ...cached, cached: true };
  const pLow = prompt.toLowerCase();

  for (const g of agent.golden) { if (g.k.some(k => pLow.includes(k))) { const res = { response: g.r, brain_used: "golden", agent_used: agentId }; cacheSet(cacheKey, res); return res; } }

  if (geminiAI && !cbCheck(CB[agentId].g)) {
    try {
      const res = await geminiAI.models.generateContent({ model: "gemini-1.5-flash", contents: `[SISTEMA: ${agent.persona}]\n\n[USUARIO]: ${prompt}`, config: { tools: [{ googleSearch: {} }] } });
      const text = res.text?.() || res.candidates?.[0]?.content?.parts?.[0]?.text || "";
      if (text && text.length > 10) { cbOk(CB[agentId].g); const result = { response: text.trim(), brain_used: "gemini", agent_used: agentId }; const cleanResult = { response: limpiarParaVoz(result.response), brain_used: result.brain_used, agent_used: result.agent_used }; cacheSet(cacheKey, cleanResult); return cleanResult; }
    } catch(e) { cbFail(CB[agentId].g); }
  }

  // WATSONX CHAIN - llama-3-3-70b antes de caer a local
  let result;
  try {
    const wxUrl = process.env.WATSONX_URL;
    const wxKey = process.env.WATSONX_API_KEY;
    const wxProj = process.env.WATSONX_PROJECT_ID;
    if (wxUrl && wxKey && wxProj) {
      // Obtener token IAM
      const access_token = await getIAMToken();
      if (access_token) {
        const wxRes = await fetch(`${wxUrl}/ml/v1/text/chat?version=2024-05-31`, {
          method: "POST",
          headers: { "Authorization": `Bearer ${access_token}`, "Content-Type": "application/json" },
          body: JSON.stringify({
            model_id: "meta-llama/llama-3-3-70b-instruct",
            project_id: wxProj,
            messages: [
              { role: "system", content: agent.persona + "\n\nINSTRUCCION CRITICA: Responde SIEMPRE en maximo 3 oraciones cortas. NO uses asteriscos, bullets, numeracion ni markdown. Habla como en una conversacion real, natural y directa. Usa punto al final de cada oracion para pausas naturales." },
              { role: "user", content: prompt }
            ],
            parameters: { max_new_tokens: 500, temperature: 0.7 }, signal: AbortSignal.timeout(25000)
          })
        });
        const wxJson = await wxRes.json();
        const wxText = wxJson.choices?.[0]?.message?.content;
        if (wxText && wxText.length > 5) {
          result = { response: limpiarParaVoz(wxText.trim()), brain_used: "watsonx", agent_used: agentId };
          cacheSet(cacheKey, result);
        }
      }
    }
  } catch(wxErr) { /* fallback a local */ }
  if (!result) {
    result = { response: agent.fallback, brain_used: "local", agent_used: agentId };
  }
  return result;
}


