// â”€â”€ IoT Camera Panel â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
const IotCameraPanel: React.FC<{
  enabled:    boolean;
  onEvidence: (hit: KeywordHit) => void;
}> = ({ enabled, onEvidence }) => {
  const videoRef   = useRef<HTMLVideoElement>(null);
  const canvasRef  = useRef<HTMLCanvasElement>(null);
  const streamRef  = useRef<MediaStream | null>(null);
  const recRef     = useRef<(() => void) | null>(null);
  const [camError, setCamError] = useState<string | null>(null);
  const [listening, setListening] = useState(false);
  const [lastHit,   setLastHit]   = useState<string | null>(null);

  const captureEvidence = useCallback(async (phrase: string): Promise<string> => {
    if (!canvasRef.current || !videoRef.current) return "";
    const ctx = canvasRef.current.getContext("2d")!;
    canvasRef.current.width  = videoRef.current.videoWidth  || 320;
    canvasRef.current.height = videoRef.current.videoHeight || 240;
    ctx.drawImage(videoRef.current, 0, 0);
    // Stamp phrase on frame
    ctx.fillStyle = "rgba(255,23,68,0.7)";
    ctx.fillRect(0, canvasRef.current.height - 22, canvasRef.current.width, 22);
    ctx.fillStyle = "#fff";
    ctx.font      = "bold 11px monospace";
    ctx.fillText(`ðŸ†˜ ${phrase.toUpperCase()} Â· ${new Date().toLocaleTimeString("es-MX")}`, 6, canvasRef.current.height - 7);
    return canvasRef.current.toDataURL("image/jpeg", 0.75);
  }, []);

  const startKeywordWatch = useCallback(() => {
    const SR = (window as any).SpeechRecognition ?? (window as any).webkitSpeechRecognition;
    if (!SR) return;
    const rec = new SR() as any;
    rec.lang          = "es-MX";
    rec.continuous    = true;
    rec.interimResults = true;
    rec.onresult = async (e: any) => {
      const transcript = Array.from(e.results as any)
        .map((r: any) => r[0].transcript.toLowerCase())
        .join(" ");
      const hit = KEYWORD_TRIGGERS.find((kw) => transcript.includes(kw));
      if (hit) {
        setLastHit(hit);
        const clip = await captureEvidence(hit);
        const hash = await sha256Hex(`KEYWORD|${hit}|${new Date().toISOString()}|${clip.slice(0, 64)}`);
        onEvidence({ phrase: hit, ts: new Date().toISOString(), clip });
        // Notify backend via chat (non-blocking)
        fetch("/api/chat", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            agent: "SANTI",
            prompt: `ALERTA DOMÃ“TICA: Palabra clave detectada "${hit}" en cÃ¡mara hogar. Hash evidencia: ${hash.slice(0,16)}. Genera protocolo de respuesta.`,
            lang: "es",
          }),
        }).catch(() => {});
      }
    };
    rec.onend = () => { if (enabled) { try { rec.start(); } catch {} } };
    rec.start();
    recRef.current = () => { try { rec.stop(); } catch {} };
    setListening(true);
  }, [enabled, captureEvidence, onEvidence]);

  useEffect(() => {
    if (!enabled) {
      streamRef.current?.getTracks().forEach((t) => t.stop());
      streamRef.current = null;
      recRef.current?.();
      recRef.current = null;
      setListening(false);
      return;
    }
    // Start camera
    navigator.mediaDevices.getUserMedia({ video: { width: 320, height: 240 }, audio: false })
      .then((stream) => {
        streamRef.current = stream;
        if (videoRef.current) { videoRef.current.srcObject = stream; videoRef.current.play(); }
        setCamError(null);
        startKeywordWatch();
      })
      .catch((err) => setCamError(`Sin cÃ¡mara: ${err.message}`));

    return () => {
      streamRef.current?.getTracks().forEach((t) => t.stop());
      recRef.current?.();
    };
  }, [enabled, startKeywordWatch]);

  if (!enabled) return null;

  return (
    <div style={{
      marginTop: 16, padding: 14, borderRadius: 10,
      background: "rgba(0,4,12,0.95)",
      border: "1px solid rgba(0,255,200,0.18)",
    }}>
      <p style={{ color: "#00ffcc", fontSize: 9, letterSpacing: "2px", margin: "0 0 10px" }}>
        ðŸ“¸ CÃMARA HOGAR â€” VINCULACIÃ“N IoT ACTIVA
        {listening && <span style={{ color: "#00e676", marginLeft: 8 }}>ðŸŽ¤ ESCUCHANDOâ€¦</span>}
      </p>

      {camError ? (
        <p style={{ color: "#ff6d00", fontSize: 9 }}>âš ï¸ {camError}</p>
      ) : (
        <div style={{ position: "relative", borderRadius: 8, overflow: "hidden", border: "1px solid rgba(0,255,200,0.25)", maxWidth: 320 }}>
          <div className="cam-scan-line" />
          <video ref={videoRef} muted playsInline style={{ width: "100%", display: "block", filter: "brightness(0.9) contrast(1.05)" }} />
        </div>
      )}
      <canvas ref={canvasRef} style={{ display: "none" }} />

      {lastHit && (
        <div className="keyword-alert" style={{
          marginTop: 10, padding: "8px 12px", borderRadius: 6,
          border: "1px solid rgba(255,23,68,0.4)", fontSize: 9, color: "#ff6d00",
        }}>
          ðŸ†˜ PALABRA CLAVE DETECTADA: <strong>"{lastHit}"</strong><br />
          Video de evidencia capturado. NotificaciÃ³n enviada al mando.
        </div>
      )}

      <p style={{ fontSize: 8, color: "#2a5a4a", marginTop: 8, lineHeight: 1.6 }}>
        Palabras clave activas: {KEYWORD_TRIGGERS.join(" Â· ")}<br />
        Al detectarse: captura de frame â†’ hash SHA-256 â†’ notificaciÃ³n automÃ¡tica a C.M.O.
      </p>
    </div>
  );
};

