import React, { useEffect, useRef, useState } from "react";
import * as maplibregl from "maplibre-gl";
import "maplibre-gl/dist/maplibre-gl.css";

const MAP_STYLE: any = {
  version: 8,
  sources: {
    "satellite": {
      type: "raster",
      tiles: ["https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"],
      tileSize: 256,
      attribution: "© Esri",
    },
    "fallback-1": {
      type: "raster",
      tiles: ["https://a.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}@2x.png"],
      tileSize: 256,
    },
  },
  layers: [
    { id: "bg", type: "background", paint: { "background-color": "#0a0f18" } },
    { id: "fallback-layer", type: "raster", source: "fallback-1", paint: { "raster-opacity": 0.7 } },
    { id: "sat-layer", type: "raster", source: "satellite", paint: { "raster-opacity": 0.95, "raster-brightness-max": 0.5 } },
  ],
};

export const TacticalMap3D = () => {
  const containerRef = useRef<HTMLDivElement>(null);
  const mapRef = useRef<maplibregl.Map | null>(null);
  const unitsRef = useRef<any>(null);
  const [pitch, setPitch] = useState(45);

  useEffect(() => {
    if (!containerRef.current || mapRef.current) return;

    const map = new maplibregl.Map({
      container: containerRef.current,
      style: MAP_STYLE,
      center: [-99.1332, 19.4326],
      zoom: 11,
      pitch: 45,
      bearing: -20,
      antialias: true,
      maxPitch: 85,
    });
    mapRef.current = map;

    map.addControl(new maplibregl.NavigationControl({ visualizePitch: true }), "top-right");

    map.on("load", () => {
      const features: any[] = [];
      const colors = ["#00ffcc", "#ff1744", "#ff9100", "#9c27b0", "#2979ff", "#00e676"];
      for (let i = 0; i < 10000; i++) {
        const angle = Math.random() * Math.PI * 2;
        const radius = Math.random() * 0.5;
        features.push({
          type: "Feature",
          properties: { color: colors[Math.floor(Math.random() * colors.length)], bearing: angle, speed: 0.0001 + Math.random() * 0.0003, turnRate: (Math.random() - 0.5) * 0.05 },
          geometry: { type: "Point", coordinates: [-99.1332 + Math.cos(angle) * radius, 19.4326 + Math.sin(angle) * radius] },
        });
      }
      unitsRef.current = { type: "FeatureCollection", features };
      map.addSource("units", { type: "geojson", data: unitsRef.current });
      map.addLayer({ id: "units-glow", type: "circle", source: "units", paint: { "circle-radius": 10, "circle-color": ["get", "color"], "circle-opacity": 0.15, "circle-blur": 1 } });
      map.addLayer({ id: "units-dot", type: "circle", source: "units", paint: { "circle-radius": 5, "circle-color": ["get", "color"], "circle-stroke-width": 1, "circle-stroke-color": "#fff" } });

      setInterval(() => {
        const src = map.getSource("units") as any;
        if (!src || !unitsRef.current) return;
        unitsRef.current.features.forEach((f: any) => {
          f.properties.bearing += f.properties.turnRate;
          f.geometry.coordinates[0] += Math.cos(f.properties.bearing) * f.properties.speed;
          f.geometry.coordinates[1] += Math.sin(f.properties.bearing) * f.properties.speed;
          const dx = f.geometry.coordinates[0] + 99.1332;
          const dy = f.geometry.coordinates[1] - 19.4326;
          if (Math.abs(dx) > 0.55 || Math.abs(dy) > 0.55) f.properties.bearing += Math.PI;
        });
        src.setData(unitsRef.current);
      }, 100);
    });

    map.on("pitchen", () => setPitch(Math.round(map.getPitch())));

    return () => { if (mapRef.current) { mapRef.current.remove(); mapRef.current = null; } };
  }, []);

  const goTo = (p: number, z: number) => {
    if (mapRef.current) mapRef.current.easeTo({ pitch: p, zoom: z, duration: 1000 });
  };

  return (
    <div style={{ width: "100vw", height: "100vh", position: "relative", background: "#020810" }}>
      <div ref={containerRef} style={{ position: "absolute", inset: 0 }} />
      <div style={{ position: "absolute", top: 20, left: 20, zIndex: 1000, color: "#00ffcc", fontFamily: "monospace", background: "rgba(0,0,0,0.85)", padding: 15, border: "1px solid #00ffcc", borderRadius: 8 }}>
        <h2 style={{ margin: 0, fontSize: 14 }}>RADAR SATELITAL ESRI</h2>
        <p style={{ margin: "5px 0 0", fontSize: 11 }}>Unidades: <b style={{ color: "#00e676" }}>10,000</b> | Pitch: {pitch}°</p>
      </div>
      <div style={{ position: "absolute", bottom: 30, left: 20, zIndex: 1000, display: "flex", flexDirection: "column", gap: 8 }}>
        <button onClick={() => goTo(0, 11)} style={{ padding: "8px 14px", background: "rgba(0,0,0,0.85)", border: "1px solid #00ffcc", color: "#00ffcc", borderRadius: 4, cursor: "pointer", fontSize: 10, fontFamily: "monospace", fontWeight: "bold" }}>2D</button>
        <button onClick={() => goTo(45, 13)} style={{ padding: "8px 14px", background: "rgba(0,0,0,0.85)", border: "1px solid #00ffcc", color: "#00ffcc", borderRadius: 4, cursor: "pointer", fontSize: 10, fontFamily: "monospace", fontWeight: "bold" }}>3D</button>
        <button onClick={() => goTo(75, 16)} style={{ padding: "8px 14px", background: "rgba(0,0,0,0.85)", border: "1px solid #00ffcc", color: "#00ffcc", borderRadius: 4, cursor: "pointer", fontSize: 10, fontFamily: "monospace", fontWeight: "bold" }}>CALLE</button>
        <button onClick={() => goTo(85, 18)} style={{ padding: "8px 14px", background: "rgba(0,0,0,0.85)", border: "1px solid #ff9100", color: "#ff9100", borderRadius: 4, cursor: "pointer", fontSize: 10, fontFamily: "monospace", fontWeight: "bold" }}>1A PERSONA</button>
      </div>
    </div>
  );
};
